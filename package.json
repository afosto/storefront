{
  "name": "@afosto/storefront",
  "version": "5.0.1",
  "private": false,
  "description": "Afosto storefront client",
  "keywords": [
    "afosto",
    "storefront",
    "storefront-client"
  ],
  "homepage": "https://github.com/afosto/storefront",
  "bugs": {
    "url": "https://github.com/afosto/storefront/issues"
  },
  "license": "MIT",
  "author": "Afosto Saas BV",
  "repository": {
    "type": "git",
    "url": "https://github.com/afosto/storefront.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && pnpm run typecheck:dist",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "typecheck:dist": "tsc --noEmit -p tsconfig.dist.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "@afosto/graphql-client": "^3.0.0",
    "@types/js-cookie": "^3.0.6",
    "js-cookie": "^3.0.8"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.1"
}
